{
  "name": "import-signing-key-action",
  "description": "GitHub Action to easily import a GPG or SSH signing key",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --define:import.meta.url=__filename --outfile=dist/index.cjs --sourcemap --minify && yarn run license",
    "lint": "eslint --max-warnings=0 .",
    "format": "eslint --fix .",
    "test": "vitest run",
    "license": "generate-license-file --input package.json --output dist/licenses.txt --overwrite --ci --no-spinner --eol lf",
    "all": "yarn run build && yarn run format && yarn test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exo-actions/import-signing-key-action.git"
  },
  "keywords": [
    "actions",
    "gpg",
    "ssh",
    "signing",
    "git"
  ],
  "author": "exoplatform",
  "license": "LGPL-3.0-only",
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "addressparser": "^1.0.1",
    "openpgp": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/addressparser": "^1.0.3",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "generate-license-file": "^4.2.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
